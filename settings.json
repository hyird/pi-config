{
  "packages": [
    "git:github.com/hyird/pi-codex-goal",
    "git:github.com/hyird/oh-my-pi-slim",
    "git:github.com/hyird/pi-multiprovider",
    "git:github.com/hyird/pi-better-usage",
    "npm:@davecodes/pi-dcp"
  ],
  "transport": "sse",
  "retry": {
    "maxRetries": 10
  },
  "quietStartup": true,
  "theme": "Codex",
  "showHardwareCursor": true,
  "images": {
    "blockImages": false
  },
  "terminal": {
    "clearOnShrink": true,
    "showTerminalProgress": true
  },
  "tuiMode": "fullscreen",
  "editorPaddingX": 1,
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "defaultProjectTrust": "always",
  "treeFilterMode": "default",
  "doubleEscapeAction": "none",
  "fullscreenCopyOnSelect": true,
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "transcript",
  "npmCommand": [
    "bun"
  ],
  "defaultThinkingLevel": "medium"
}
